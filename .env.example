# Meeting Cost Calculator — build-time config (Vite embeds into the client bundle).
# Copy to `.env` for local dev. In Coolify/Docker: set as environment variables before build.

# --- Links ---
VITE_TIPS_URL=https://example.com/meeting-tips

# --- Work time (→ work days per year) ---
# Either set components below (default → 220 days) or override directly:
# VITE_WORK_DAYS_PER_YEAR=220
VITE_DAYS_PER_YEAR=365
VITE_WEEKEND_DAYS=104
VITE_VACATION_DAYS=30
VITE_PUBLIC_HOLIDAYS=11
VITE_HOURS_PER_WEEK=38
VITE_WORK_DAYS_PER_WEEK=5

# --- Standard persona annual salaries (EUR) ---
VITE_SALARY_TARIFF=90000
VITE_SALARY_NON_TARIFF=150000
VITE_SALARY_EXECUTIVE=300000
VITE_SALARY_BOARD=3000000
